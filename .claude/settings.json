{
  "model": "opus[1m]",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "teammateMode": "tmux",
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/scripts/session-install.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/scripts/test-edit-context.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "sh .claude/statusline-command.sh"
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "excludedCommands": [
      "git push*",
      "git pull*",
      "git fetch*",
      "gh pr *",
      "gh issue *",
      "gh repo *",
      "gh release *",
      "gh workflow *",
      "gh run *",
      "gh api *",
      "curl*",
      "wget*",
      "npm run dev*",
      "npm run preview*",
      "npm run test:e2e*",
      "npm run pretest:e2e*",
      "npm run pretest:vrt*",
      "npx astro dev*",
      "npx astro preview*",
      "npx playwright test*"
    ],
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": [
        "registry.npmjs.org",
        "*.npmjs.org",
        "github.com",
        "*.github.com",
        "api.github.com",
        "objects.githubusercontent.com",
        "raw.githubusercontent.com",
        "codeload.github.com",
        "api.anthropic.com",
        "*.anthropic.com",
        "statsig.anthropic.com",
        "cdn.playwright.dev",
        "playwright.azureedge.net",
        "docs.anthropic.com",
        "code.claude.com",
        "ai.google.dev"
      ]
    }
  },
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Read(./**)",
      "Read(~/.claude/**)",
      "Read(/private/tmp/claude/**)",
      "Read(/private/tmp/claude-[0-9a-f]*/**)",
      "Read(/tmp/claude/**)",
      "Read(/tmp/claude-[0-9a-f]*/**)",
      "Read(/var/folders/*/*/T/**)",
      "Edit(./**)",
      "Edit(/private/tmp/claude/**)",
      "Edit(/private/tmp/claude-[0-9a-f]*/**)",
      "Edit(/tmp/claude/**)",
      "Edit(/tmp/claude-[0-9a-f]*/**)",
      "Edit(/var/folders/*/*/T/**)",
      "WebFetch(domain:ai.google.dev)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:docs.anthropic.com)",
      "Bash(npm --version)",
      "Bash(npm ci)",
      "Bash(npm list*)",
      "Bash(npm outdated*)",
      "Bash(npm run *)",
      "Bash(npm test*)",
      "Bash(npm view *)",
      "Bash(npx astro *)",
      "Bash(npx playwright *)",
      "Bash(npx prettier --check *)",
      "Bash(npx prettier --write .)",
      "Bash(npx prettier --write .agents/*)",
      "Bash(npx prettier --write .claude/*)",
      "Bash(npx prettier --write docs/*)",
      "Bash(npx prettier --write src/*)",
      "Bash(npx prettier --write tests/*)",
      "Bash(npx tsc *)",
      "Bash(npx vitest *)",
      "Bash(node_modules/.bin/astro check*)",
      "Bash(git add *)",
      "Bash(git branch*)",
      "Bash(git branch -D worktree-agent-*)",
      "Bash(git checkout -B worktree-agent-*)",
      "Bash(git checkout -b *)",
      "Bash(git commit -m *)",
      "Bash(git config --get*)",
      "Bash(git diff*)",
      "Bash(git fetch*)",
      "Bash(git log*)",
      "Bash(git merge --ff-only *)",
      "Bash(git pull*)",
      "Bash(git rebase --abort)",
      "Bash(git rebase --continue)",
      "Bash(git rebase --onto *)",
      "Bash(git rebase --skip)",
      "Bash(git remote -v)",
      "Bash(git rev-parse*)",
      "Bash(git show*)",
      "Bash(git stash list*)",
      "Bash(git status*)",
      "Bash(git switch *)",
      "Bash(git worktree prune*)",
      "Bash(git worktree remove*)",
      "Bash(gh issue comment*)",
      "Bash(gh issue list*)",
      "Bash(gh issue status*)",
      "Bash(gh issue view*)",
      "Bash(gh label list*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr comment*)",
      "Bash(gh pr diff*)",
      "Bash(gh pr list*)",
      "Bash(gh pr review*)",
      "Bash(gh pr status*)",
      "Bash(gh pr view*)",
      "Bash(gh repo list*)",
      "Bash(gh repo view*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "Bash(gh run watch*)",
      "Bash(gh workflow list*)",
      "Bash(gh auth status)",
      "Bash(gh workflow view*)",
      "Bash(bash scripts/rm-tmp.sh *)",
      "Bash(node --version)",
      "Bash(pwd)",
      "Bash(which *)",
      "mcp__playwright__browser_console_messages",
      "mcp__playwright__browser_take_screenshot"
    ],
    "ask": [
      "Edit(**/.claude/{*.json,*.sh,hooks/**,agents/**,skills/**,commands/**,plugins/**})",
      "Edit(./.gemini/**)",
      "Bash(git push*)",
      "Bash(git reset --hard*)",
      "Bash(git commit --amend*)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit -n *)",
      "Bash(git commit * -n)",
      "Bash(git commit * --no-verify*)",
      "Bash(git commit -am *)",
      "Bash(git add -A*)",
      "Bash(git add --all*)",
      "Bash(git add .)",
      "Bash(npm install *)",
      "Bash(npm exec *)",
      "Bash(gh pr create*)",
      "Bash(gh issue create*)",
      "Bash(gh pr merge*)",
      "Bash(gh pr close*)",
      "Bash(gh pr edit*)",
      "Bash(gh release *)",
      "Bash(gh repo archive*)",
      "Bash(gh repo rename*)",
      "Bash(gh issue delete*)",
      "Bash(gh issue close*)",
      "Bash(gh issue edit*)",
      "Bash(gh workflow run*)",
      "Bash(gh workflow disable*)",
      "Bash(gh api *)",
      "Bash(curl*)",
      "Bash(wget*)",
      "Bash(rm .claude/*)",
      "Bash(rm -rf .claude*)",
      "Bash(rm .gemini/*)",
      "Bash(rm -rf .gemini*)",
      "Bash(sed -i* .claude/*)",
      "Bash(sed -i* .gemini/*)",
      "Bash(tee .claude/*)",
      "Bash(tee .gemini/*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(gh repo delete*)",
      "Bash(gh secret delete*)",
      "Bash(gh secret remove*)",
      "Bash(gh secret set*)",
      "Bash(gh ssh-key delete*)",
      "Bash(gh auth logout*)",
      "Bash(gh api graphql)",
      "Bash(gh api graphql *)",
      "Bash(gh api * graphql)",
      "Bash(gh api * graphql *)",
      "Bash(gh api * -X DELETE*)",
      "Bash(gh api * --method DELETE*)",
      "Bash(npm install -g*)",
      "Bash(npm install --global*)",
      "Bash(npm install --location=global*)",
      "Bash(npm install --location global*)",
      "Bash(npm i -g*)",
      "Bash(npm i --global*)",
      "Read(./.env*)",
      "Read(./secrets/**)",
      "Read(~/.aws/**)",
      "Read(~/.ssh/**)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(npm publish*)",
      "Bash(curl * | sh*)",
      "Bash(curl * | bash*)",
      "Bash(wget * | sh*)",
      "Bash(wget * | bash*)"
    ]
  }
}
