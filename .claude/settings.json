{
  "model": "opusplan",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "teammateMode": "tmux",
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "context7@claude-plugins-official": true
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "if [ \"$CLAUDE_CODE_REMOTE\" = \"true\" ] && [ ! -d node_modules ]; then npm ci; fi"
          },
          {
            "type": "command",
            "command": "if [ \"$CLAUDE_CODE_REMOTE\" = \"true\" ]; then for p in superpowers frontend-design context7; do grep -q \"${p}@claude-plugins-official\" ~/.claude/plugins/installed_plugins.json 2>/dev/null || claude plugin install \"${p}@claude-plugins-official\" --scope user < /dev/null 2>&1 | head -3 || true; done; fi"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "sh .claude/statusline-command.sh"
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "excludedCommands": [
      "git push*",
      "git pull*",
      "git fetch*",
      "gh pr *",
      "gh issue *",
      "gh repo *",
      "gh release *",
      "gh workflow *",
      "gh api *",
      "curl*",
      "wget*",
      "npm run dev*",
      "npm run preview*",
      "npm run test:e2e*",
      "npx astro dev*",
      "npx astro preview*",
      "npx playwright test*"
    ],
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": [
        "registry.npmjs.org",
        "*.npmjs.org",
        "github.com",
        "*.github.com",
        "api.github.com",
        "objects.githubusercontent.com",
        "raw.githubusercontent.com",
        "codeload.github.com",
        "api.anthropic.com",
        "*.anthropic.com",
        "statsig.anthropic.com",
        "cdn.playwright.dev",
        "playwright.azureedge.net",
        "docs.anthropic.com",
        "code.claude.com",
        "ai.google.dev"
      ]
    }
  },
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Read(./**)",
      "Read(~/.claude/**)",
      "Edit(./**)",
      "Write(./**)",
      "Write(/tmp/claude/**)",
      "Write(/tmp/claude-*/**)",
      "Write(/private/tmp/claude/**)",
      "Write(/private/tmp/claude-*/**)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:ai.google.dev)",
      "Bash(npm run *)",
      "Bash(npm test*)",
      "Bash(npm ci)",
      "Bash(npm install *)",
      "Bash(npm list*)",
      "Bash(npm outdated*)",
      "Bash(npm view *)",
      "Bash(npm exec *)",
      "Bash(npx playwright *)",
      "Bash(npx tsc *)",
      "Bash(npx vitest *)",
      "Bash(npx astro *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git rev-parse*)",
      "Bash(git pull*)",
      "Bash(git fetch*)",
      "Bash(git remote -v)",
      "Bash(git stash list*)",
      "Bash(git config --get*)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)",
      "Bash(git checkout -B worktree-agent-*)",
      "Bash(git add *)",
      "Bash(git commit -m *)",
      "Bash(git commit -am *)",
      "Bash(git rebase --onto *)",
      "Bash(git rebase --abort)",
      "Bash(git rebase --continue)",
      "Bash(git rebase --skip)",
      "Bash(git merge --ff-only *)",
      "Bash(git branch -D worktree-agent-*)",
      "Bash(gh pr list*)",
      "Bash(gh pr view*)",
      "Bash(gh pr status*)",
      "Bash(gh pr diff*)",
      "Bash(gh pr review*)",
      "Bash(gh pr comment*)",
      "Bash(gh issue list*)",
      "Bash(gh issue view*)",
      "Bash(gh issue status*)",
      "Bash(gh repo view*)",
      "Bash(gh repo list*)",
      "Bash(node --version)",
      "Bash(npm --version)",
      "Bash(which *)",
      "Bash(pwd)"
    ],
    "ask": [
      "Edit(**/.claude/{*.json,*.sh,hooks/**,agents/**,skills/**,commands/**,plugins/**})",
      "Write(**/.claude/{*.json,*.sh,hooks/**,agents/**,skills/**,commands/**,plugins/**})",
      "Edit(./.gemini/**)",
      "Write(./.gemini/**)",
      "Bash(git push*)",
      "Bash(git reset --hard*)",
      "Bash(git commit --amend*)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit -n *)",
      "Bash(git commit * -n)",
      "Bash(git commit * --no-verify*)",
      "Bash(git add -A*)",
      "Bash(git add --all*)",
      "Bash(git add .)",
      "Bash(gh pr create*)",
      "Bash(gh pr merge*)",
      "Bash(gh pr close*)",
      "Bash(gh pr edit*)",
      "Bash(gh release *)",
      "Bash(gh repo archive*)",
      "Bash(gh repo rename*)",
      "Bash(gh issue delete*)",
      "Bash(gh issue close*)",
      "Bash(gh workflow run*)",
      "Bash(gh workflow disable*)",
      "Bash(gh api *)",
      "Bash(curl*)",
      "Bash(wget*)",
      "Bash(rm .claude/*)",
      "Bash(rm -rf .claude*)",
      "Bash(rm .gemini/*)",
      "Bash(rm -rf .gemini*)",
      "Bash(sed -i* .claude/*)",
      "Bash(sed -i* .gemini/*)",
      "Bash(tee .claude/*)",
      "Bash(tee .gemini/*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(gh repo delete*)",
      "Bash(gh secret delete*)",
      "Bash(gh secret remove*)",
      "Bash(gh secret set*)",
      "Bash(gh ssh-key delete*)",
      "Bash(gh auth logout*)",
      "Bash(gh api graphql)",
      "Bash(gh api graphql *)",
      "Bash(gh api * graphql)",
      "Bash(gh api * graphql *)",
      "Bash(gh api * -X DELETE*)",
      "Bash(gh api * --method DELETE*)",
      "Bash(npm install -g*)",
      "Bash(npm install --global*)",
      "Bash(npm install --location=global*)",
      "Bash(npm install --location global*)",
      "Bash(npm i -g*)",
      "Bash(npm i --global*)",
      "Read(./.env*)",
      "Read(./secrets/**)",
      "Read(~/.aws/**)",
      "Read(~/.ssh/**)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(npm publish*)",
      "Bash(curl * | sh*)",
      "Bash(curl * | bash*)",
      "Bash(wget * | sh*)",
      "Bash(wget * | bash*)"
    ]
  }
}
