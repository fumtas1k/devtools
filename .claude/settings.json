{
  "model": "opusplan",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "teammateMode": "tmux",
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "context7@claude-plugins-official": true
  },
  "statusLine": {
    "type": "command",
    "command": "sh .claude/statusline-command.sh"
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "excludedCommands": ["git push*", "gh *"],
    "network": {
      "allowedDomains": [
        "registry.npmjs.org",
        "*.npmjs.org",
        "github.com",
        "*.github.com",
        "api.github.com",
        "objects.githubusercontent.com",
        "raw.githubusercontent.com",
        "codeload.github.com",
        "api.anthropic.com",
        "*.anthropic.com",
        "statsig.anthropic.com",
        "cdn.playwright.dev",
        "playwright.azureedge.net"
      ]
    }
  },
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Read(./**)",
      "Read(~/.claude/**)",
      "Edit(./**)",
      "Write(./**)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:code.claude.com)",
      "Bash(npm run *)",
      "Bash(npm test*)",
      "Bash(npm ci)",
      "Bash(npm install)",
      "Bash(npm install --save-dev *)",
      "Bash(npm install --save *)",
      "Bash(npm list*)",
      "Bash(npm outdated*)",
      "Bash(npm view *)",
      "Bash(npm exec *)",
      "Bash(npx playwright *)",
      "Bash(npx tsc *)",
      "Bash(npx vitest *)",
      "Bash(npx astro *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git rev-parse*)",
      "Bash(git remote -v)",
      "Bash(git stash list*)",
      "Bash(git config --get*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr diff*)",
      "Bash(gh pr checks*)",
      "Bash(gh issue view*)",
      "Bash(gh issue list*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "Bash(gh api repos/*)",
      "Bash(node --version)",
      "Bash(npm --version)",
      "Bash(which *)",
      "Bash(pwd)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(git reset --hard*)",
      "Bash(gh pr create*)",
      "Bash(gh pr merge*)",
      "Bash(gh pr close*)",
      "Bash(gh pr edit*)",
      "Bash(gh release *)",
      "Bash(npm install -g*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Read(./.env*)",
      "Read(./secrets/**)",
      "Read(~/.aws/**)",
      "Read(~/.ssh/**)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(npm publish*)",
      "Bash(curl * | sh*)",
      "Bash(curl * | bash*)",
      "Bash(wget * | sh*)",
      "Bash(wget * | bash*)"
    ]
  }
}
