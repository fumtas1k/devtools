#!/bin/sh
# コミットメッセージの言語チェック
#
# コミットメッセージが英語で書かれていないことを確認する。
# メッセージが主に日本語で書かれていることを確認する。

RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

commit_msg_file="$1"

# コミットメッセージを読む（最初の行のみ、コメント行を除外）
commit_msg=$(grep -v '^#' "$commit_msg_file" | head -1)

# 空のメッセージはスキップ
if [ -z "$commit_msg" ]; then
  exit 0
fi

# 日本語の文字（ひらがな、カタカナ、漢字）を検出する正規表現
# Unicode 範囲:
# - ひらがな: U+3040-U+309F
# - カタカナ: U+30A0-U+30FF
# - 漢字: U+4E00-U+9FFF
# - 句読点: U+3001-U+3006

japanese_count=$(echo "$commit_msg" | grep -o '[ぁ-ん]' | wc -l)
japanese_count=$((japanese_count + $(echo "$commit_msg" | grep -o '[ァ-ン]' | wc -l)))
japanese_count=$((japanese_count + $(echo "$commit_msg" | grep -o '[一-龯]' | wc -l)))
japanese_count=$((japanese_count + $(echo "$commit_msg" | grep -o '[、。]' | wc -l)))

# 英字（a-z, A-Z）の数をカウント
ascii_alpha_count=$(echo "$commit_msg" | grep -o '[a-zA-Z]' | wc -l)

# 数字は除外（バージョン番号など）
# 記号は除外

# 日本語文字がない、または英字が多すぎる場合はエラー
if [ "$japanese_count" -lt 2 ] && [ "$ascii_alpha_count" -gt 5 ]; then
  printf "${RED}✗ エラー: コミットメッセージが日本語で書かれていません。${NC}\n" >&2
  printf "${RED}必ず日本語でコミットメッセージを書いてください。${NC}\n\n" >&2
  printf "例（正しい形式）:\n" >&2
  printf "  feat: 新しいツールを追加\n" >&2
  printf "  fix: XSS 脆弱性を修正\n" >&2
  printf "  refactor: base64url 変換を統合\n\n" >&2
  printf "コミットメッセージ: ${YELLOW}${commit_msg}${NC}\n" >&2
  exit 1
fi

exit 0
