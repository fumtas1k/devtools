{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash .codex/scripts/session-install.sh",
            "statusMessage": "依存関係を確認中"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .codex/scripts/block-direct-git-add.sh",
            "statusMessage": "git add の実行経路を確認中"
          }
        ]
      },
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .codex/scripts/test-edit-context.sh",
            "statusMessage": "テスト編集ルールを確認中"
          }
        ]
      }
    ]
  }
}
