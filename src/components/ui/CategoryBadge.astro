---
interface Props {
  label: string;
  class?: string;
}
const { label, class: extraClass = '' } = Astro.props;
---
<span
  class:list={['rounded-full px-3 font-bold text-blue-800 bg-blue-100', extraClass]}
  style="font-size: 0.875rem; line-height: 1; letter-spacing: 0.02em;"
>
  {label}
</span>
