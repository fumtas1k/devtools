---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageContainer from '@/components/ui/PageContainer.astro';
import ToolCard from '@/components/ui/ToolCard.astro';
import { tools, categoryLabel, categories } from '@/data/tools';

const allCategories = ['all', ...categories] as const;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'DevTools',
  url: Astro.site?.href ?? 'https://devtools-d9w.pages.dev/',
  description: 'ブラウザで完結する無料の開発者ツール集',
  inLanguage: 'ja',
};
---

<BaseLayout
  title="無料オンライン開発者ツール集"
  description="ブラウザで完結する無料の開発者ツール集。URLエンコード、JWTデコード、ULID生成など。"
  jsonLd={jsonLd}
>
  <!-- ヒーロー -->
  <section class="text-center px-4 py-8 bg-background border-b border-hero">
    <h1 class="mb-2 font-bold hero-heading text-default">DevTools</h1>
    <p class="text-base leading-[1.7] tracking-[0.02em] text-muted">
      ブラウザで完結する無料の開発者ツール集
    </p>
  </section>

  <!-- ツール一覧 -->
  <main id="main-content">
    <PageContainer class="py-8">
      <!-- 検索 -->
      <div class="mb-6">
        <div class="relative">
          <span
            class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-icon"
            aria-hidden="true"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
          </span>
          <input
            type="search"
            id="tool-search"
            aria-label="ツールを検索"
            aria-controls="search-results"
            autocomplete="off"
            placeholder="ツール名・用途で検索（例: json / じぇいそん）"
            class="field-control pl-10 pr-10"
          />
          <button
            type="button"
            id="search-clear"
            aria-label="検索をクリア"
            class="btn-clear absolute right-0.5 top-1/2 inline-flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-md border-0 text-muted"
            hidden
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>
        <p
          id="search-status"
          role="status"
          aria-live="polite"
          class="mt-2 caption text-muted"
          hidden
        ></p>
      </div>

      <!-- 検索結果（横断絞り込み） -->
      <div id="search-results" hidden>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {tools.map((tool) => (
            <ToolCard tool={tool} />
          ))}
        </div>
      </div>

      <!-- タブ -->
      <div
        id="tab-bar"
        role="tablist"
        aria-label="カテゴリ絞り込み"
        class="mb-6 flex flex-wrap gap-1 border-b border-hero overflow-visible md:flex-nowrap md:overflow-x-auto"
      >
        <button
          type="button"
          role="tab"
          id="tab-0"
          aria-selected="true"
          aria-controls="panel-0"
          data-index="0"
          class="tab-btn focus-inset shrink-0 whitespace-nowrap px-4 py-2 min-h-11 font-bold border-b-2 -mb-px transition-colors text-sm tracking-[0.02em]"
        >
          すべて
        </button>
        {categories.map((cat, i) => <button
          type="button"
          role="tab"
          id={`tab-${i + 1}`}
          aria-selected="false"
          aria-controls={`panel-${i + 1}`}
          data-index={i + 1}
          class="tab-btn focus-inset shrink-0 whitespace-nowrap px-4 py-2 min-h-11 font-bold border-b-2 -mb-px transition-colors text-sm tracking-[0.02em]"
        >
          {categoryLabel[cat]}
        </button>)}
      </div>

      <!-- スワイプパネル -->
      <div id="panels" class="-m-4 flex scroll-snap-x">
        {allCategories.map((cat, i) => <div
          role="tabpanel"
          id={`panel-${i}`}
          aria-labelledby={`tab-${i}`}
          class="basis-full shrink-0 grow-0 snap-start min-w-0 p-4"
        >
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {tools
              .filter((t) => cat === 'all' || t.category === cat)
              .map((tool) => (
                <ToolCard tool={tool} />
              ))}
          </div>
        </div>)}
      </div>
    </PageContainer>
  </main>
</BaseLayout>

<style>
  #panels::-webkit-scrollbar {
    display: none;
  }
  #tab-bar {
    scrollbar-width: none;
  }
  #tab-bar::-webkit-scrollbar {
    display: none;
  }
  .tab-btn[aria-selected='true'] {
    color: var(--color-primary);
    border-color: var(--color-primary);
  }
  .tab-btn[aria-selected='false'] {
    color: var(--color-muted);
    border-color: transparent;
  }
  .tab-btn[aria-selected='false']:hover {
    color: var(--color-primary);
    border-color: var(--color-primary);
  }

  /* type="search" のブラウザ既定クリアボタンは独自の #search-clear と二重になるため隠す */
  #tool-search::-webkit-search-cancel-button {
    display: none;
  }
</style>

<script>
  import { queryTokens } from '@/utils/tool-search';

  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.tab-btn'));
  const panels = document.getElementById('panels')!;
  const tabBar = document.getElementById('tab-bar')!;
  const panelItems = Array.from(panels.querySelectorAll<HTMLElement>('[role=tabpanel]'));
  let selectedIndex = 0;
  const supportsInert = 'inert' in HTMLElement.prototype;
  function updateTabStops(index: number) {
    tabs.forEach((tab, i) => {
      tab.tabIndex = i === index ? 0 : -1;
    });
  }

  // JS / inert 非対応時は元の操作可能な全パネルを維持する。
  if (supportsInert) {
    panelItems.forEach((panel, i) => {
      panel.inert = i !== selectedIndex;
    });
    updateTabStops(selectedIndex);
  }

  function activateTab(index: number) {
    if (supportsInert) {
      panelItems[index].inert = false;
      if (index !== selectedIndex && panelItems[selectedIndex].contains(document.activeElement)) {
        panelItems[index].tabIndex = -1;
        panelItems[index].focus({ preventScroll: true });
        if (document.activeElement !== panelItems[index]) {
          // フォーカスの移動に失敗した場合、旧パネルを操作可能なまま保つ。
          panelItems[index].inert = true;
          panels.scrollTo({ left: selectedIndex * panels.clientWidth, behavior: 'instant' });
          return;
        }
      }
      panelItems.forEach((panel, i) => {
        panel.inert = i !== index;
      });
    }
    selectedIndex = index;
    tabs.forEach((t, i) => {
      t.setAttribute('aria-selected', String(i === index));
    });
    if (supportsInert) {
      const focusedIndex = tabs.findIndex((tab) => tab === document.activeElement);
      updateTabStops(focusedIndex === -1 ? index : focusedIndex);
    }
    // タブバーだけを横スクロールし、ページの縦位置は変えない。
    const tab = tabs[index];
    const barRect = tabBar.getBoundingClientRect();
    const tabRect = tab.getBoundingClientRect();
    if (tabRect.left < barRect.left || tabRect.right > barRect.right) {
      tabBar.scrollTo({
        left: tabBar.scrollLeft + tabRect.left - barRect.left - (barRect.width - tabRect.width) / 2,
      });
    }
  }

  tabBar.addEventListener('focusin', (event) => {
    if (!supportsInert) return;
    const index = tabs.findIndex((tab) => tab === event.target);
    if (index !== -1) updateTabStops(index);
  });
  tabBar.addEventListener('focusout', (event) => {
    if (
      supportsInert &&
      (!(event.relatedTarget instanceof Node) || !tabBar.contains(event.relatedTarget))
    ) {
      updateTabStops(selectedIndex);
    }
  });
  tabBar.addEventListener('keydown', (event) => {
    if (!supportsInert) return;
    const current = tabs.findIndex((tab) => tab === document.activeElement);
    if (current === -1) return;
    let next: number;
    switch (event.key) {
      case 'ArrowRight':
        next = (current + 1) % tabs.length;
        break;
      case 'ArrowLeft':
        next = (current - 1 + tabs.length) % tabs.length;
        break;
      case 'Home':
        next = 0;
        break;
      case 'End':
        next = tabs.length - 1;
        break;
      default:
        return;
    }
    event.preventDefault();
    tabs[next].focus();
  });

  // タブクリックでパネルにスクロール
  tabs.forEach((tab, i) => {
    tab.addEventListener('click', () => {
      panels.scrollTo({ left: i * panels.clientWidth, behavior: 'smooth' });
      activateTab(i);
    });
  });

  // スワイプ後にタブを同期
  panels.addEventListener('scrollend', () => {
    if (panels.hidden || panels.clientWidth === 0) return;
    const i = Math.round(panels.scrollLeft / panels.clientWidth);
    if (i >= 0 && i < tabs.length) activateTab(i);
  });

  // ── 検索: 入力中はタブ/パネルを隠し、全ツール横断の結果グリッドへ切り替える ──
  const searchInput = document.getElementById('tool-search') as HTMLInputElement;
  const searchClear = document.getElementById('search-clear')!;
  const searchResults = document.getElementById('search-results')!;
  const searchStatus = document.getElementById('search-status')!;
  const resultCards = Array.from(searchResults.querySelectorAll<HTMLElement>('[data-search]'));

  // 表示制御は `hidden` 属性で行う（`src/styles/base.css` の `[hidden]{display:none!important}`
  // が Tailwind の `.flex` / `.block` に勝つ）。inline style / CSSOM mutation を
  // 避けることで CSP style-src を侵さない。
  function applySearch() {
    // 空白区切りの複数語は全トークン AND マッチ（「json csv」で JSON/CSV のみヒット）
    const tokens = queryTokens(searchInput.value);
    const searching = tokens.length > 0;

    searchClear.hidden = !searching;
    tabBar.hidden = searching;
    panels.hidden = searching;
    searchResults.hidden = !searching;
    searchStatus.hidden = !searching;

    if (!searching) {
      searchStatus.textContent = '';
      return;
    }

    let count = 0;
    for (const card of resultCards) {
      const haystack = card.dataset.search ?? '';
      const hit = tokens.every((token) => haystack.includes(token));
      card.hidden = !hit;
      if (hit) count++;
    }
    searchStatus.textContent =
      count > 0 ? `${count} 件のツールが見つかりました` : '該当するツールがありません';
  }

  searchInput.addEventListener('input', applySearch);
  searchClear.addEventListener('click', () => {
    searchInput.value = '';
    applySearch();
    searchInput.focus();
  });
</script>
