---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageContainer from '@/components/ui/PageContainer.astro';
import ToolCard from '@/components/ui/ToolCard.astro';
import { tools, categoryLabel, categories } from '@/data/tools';

const allCategories = ['all', ...categories] as const;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'DevTools',
  url: Astro.site?.href ?? 'https://devtools-d9w.pages.dev/',
  description: 'ブラウザで完結する無料の開発者ツール集',
  inLanguage: 'ja',
};
---

<BaseLayout
  title="無料オンライン開発者ツール集"
  description="ブラウザで完結する無料の開発者ツール集。URLエンコード、JWTデコード、ULID生成など。"
  jsonLd={jsonLd}
>
  <!-- ヒーロー -->
  <section
    class="text-center px-4 py-8 bg-[var(--color-background)] border-b border-[var(--color-blue-100)]"
  >
    <h1 class="mb-2 font-bold hero-heading text-default">
      DevTools
    </h1>
    <p class="text-base leading-[1.7] tracking-[0.02em] text-[var(--color-neutral-600)]">
      ブラウザで完結する無料の開発者ツール集
    </p>
  </section>

  <!-- ツール一覧 -->
  <main id="main-content">
    <PageContainer class="py-8">
      <!-- 検索 -->
      <div class="mb-6">
        <div class="relative">
          <span
            class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-icon"
            aria-hidden="true"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
          </span>
          <input
            type="search"
            id="tool-search"
            aria-label="ツールを検索"
            aria-controls="search-results"
            autocomplete="off"
            placeholder="ツール名・用途で検索（例: json / じぇいそん）"
            class="w-full rounded-lg border border-input bg-default text-default caption py-2.5 pl-10 pr-10"
          />
          <button
            type="button"
            id="search-clear"
            aria-label="検索をクリア"
            class="btn-clear absolute right-2 top-1/2 -translate-y-1/2 rounded-md border-0 p-1.5 text-muted"
            hidden
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>
        <p
          id="search-status"
          role="status"
          aria-live="polite"
          class="mt-2 caption text-muted"
          hidden
        >
        </p>
      </div>

      <!-- 検索結果（横断絞り込み） -->
      <div id="search-results" hidden>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {tools.map((tool) => <ToolCard tool={tool} />)}
        </div>
      </div>

      <!-- タブ -->
      <div
        id="tab-bar"
        role="tablist"
        aria-label="カテゴリ絞り込み"
        class="mb-6 flex gap-1 border-b border-default overflow-x-auto"
      >
        <button
          type="button"
          role="tab"
          id="tab-0"
          aria-selected="true"
          aria-controls="panel-0"
          data-index="0"
          class="tab-btn shrink-0 whitespace-nowrap px-4 py-2 font-bold border-b-2 -mb-px transition-colors text-sm tracking-[0.02em]"
        >
          すべて
        </button>
        {
          categories.map((cat, i) => (
            <button
              type="button"
              role="tab"
              id={`tab-${i + 1}`}
              aria-selected="false"
              aria-controls={`panel-${i + 1}`}
              data-index={i + 1}
              class="tab-btn shrink-0 whitespace-nowrap px-4 py-2 font-bold border-b-2 -mb-px transition-colors text-sm tracking-[0.02em]"
            >
              {categoryLabel[cat]}
            </button>
          ))
        }
      </div>

      <!-- スワイプパネル -->
      <div id="panels" class="flex scroll-snap-x">
        {
          allCategories.map((cat, i) => (
            <div
              role="tabpanel"
              id={`panel-${i}`}
              aria-labelledby={`tab-${i}`}
              class="basis-full shrink-0 grow-0 snap-start min-w-0"
            >
              <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                {tools
                  .filter((t) => cat === 'all' || t.category === cat)
                  .map((tool) => (
                    <ToolCard tool={tool} />
                  ))}
              </div>
            </div>
          ))
        }
      </div>
    </PageContainer>
  </main>
</BaseLayout>

<style>
  #panels::-webkit-scrollbar {
    display: none;
  }
  #tab-bar {
    scrollbar-width: none;
  }
  #tab-bar::-webkit-scrollbar {
    display: none;
  }
  .tab-btn[aria-selected='true'] {
    color: var(--color-primary);
    border-color: var(--color-primary);
  }
  .tab-btn[aria-selected='false'] {
    color: var(--color-muted);
    border-color: transparent;
  }
  .tab-btn[aria-selected='false']:hover {
    color: var(--color-primary);
    border-color: var(--color-primary);
  }

  /* type="search" のブラウザ既定クリアボタンは独自の #search-clear と二重になるため隠す */
  #tool-search::-webkit-search-cancel-button {
    display: none;
  }
</style>

<script>
  import { queryTokens } from '@/utils/tool-search';

  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.tab-btn'));
  const panels = document.getElementById('panels')!;

  function activateTab(index: number) {
    tabs.forEach((t, i) => {
      t.setAttribute('aria-selected', String(i === index));
    });
    // タブが溢れるスマホ幅でスワイプ時に active タブがタブバー外へ隠れないよう追従させる
    tabs[index]?.scrollIntoView({ inline: 'center', block: 'nearest' });
  }

  // タブクリックでパネルにスクロール
  tabs.forEach((tab, i) => {
    tab.addEventListener('click', () => {
      panels.scrollTo({ left: i * panels.clientWidth, behavior: 'smooth' });
      activateTab(i);
    });
  });

  // スワイプ後にタブを同期
  panels.addEventListener('scrollend', () => {
    const i = Math.round(panels.scrollLeft / panels.clientWidth);
    activateTab(i);
  });

  // ── 検索: 入力中はタブ/パネルを隠し、全ツール横断の結果グリッドへ切り替える ──
  const tabBar = document.getElementById('tab-bar')!;
  const searchInput = document.getElementById('tool-search') as HTMLInputElement;
  const searchClear = document.getElementById('search-clear')!;
  const searchResults = document.getElementById('search-results')!;
  const searchStatus = document.getElementById('search-status')!;
  const resultCards = Array.from(searchResults.querySelectorAll<HTMLElement>('[data-search]'));

  // 表示制御は `hidden` 属性で行う（global.css の `[hidden]{display:none!important}`
  // が Tailwind の `.flex` / `.block` に勝つ）。inline style / CSSOM mutation を
  // 避けることで CSP style-src を侵さない。
  function applySearch() {
    // 空白区切りの複数語は全トークン AND マッチ（「json csv」で JSON/CSV のみヒット）
    const tokens = queryTokens(searchInput.value);
    const searching = tokens.length > 0;

    searchClear.hidden = !searching;
    tabBar.hidden = searching;
    panels.hidden = searching;
    searchResults.hidden = !searching;
    searchStatus.hidden = !searching;

    if (!searching) {
      searchStatus.textContent = '';
      return;
    }

    let count = 0;
    for (const card of resultCards) {
      const haystack = card.dataset.search ?? '';
      const hit = tokens.every((token) => haystack.includes(token));
      card.hidden = !hit;
      if (hit) count++;
    }
    searchStatus.textContent =
      count > 0 ? `${count} 件のツールが見つかりました` : '該当するツールがありません';
  }

  searchInput.addEventListener('input', applySearch);
  searchClear.addEventListener('click', () => {
    searchInput.value = '';
    applySearch();
    searchInput.focus();
  });
</script>
