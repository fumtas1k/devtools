---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { tools } from '@/data/tools';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'About | DevTools',
  url: new URL('/about', Astro.site).href,
  description: 'DevTools について — ブラウザで完結する無料の開発者ツール集',
  inLanguage: 'ja',
};
---

<BaseLayout
  title="About"
  description="DevTools について — ブラウザで完結する無料の開発者ツール集"
  jsonLd={jsonLd}
>
  <main class="mx-auto max-w-2xl px-6 py-12" id="main-content">
    <h1 class="mb-8 font-bold page-heading text-default">About</h1>

    <section class="mb-10">
      <h2 class="mb-3 font-bold section-heading text-default">DevTools とは</h2>
      <p class="text-body">
        DevTools は、ブラウザだけで完結する無料の開発者向けユーティリティです。
        インストール不要・ユーザー登録不要で、すべての処理をクライアントサイドで実行します。
        入力したデータが外部サーバーに送信されることはありません。
      </p>
    </section>

    <section class="mb-10">
      <h2 class="mb-3 font-bold section-heading text-default">設計方針</h2>
      <ul class="space-y-2 text-body">
        <li>
          <strong>ブラウザ完結</strong> — すべての処理はブラウザ内で完結します。データは外部に送信されません。
        </li>
        <li><strong>依存最小化</strong> — ツールごとに必要な最小限のライブラリのみ使用します。</li>
        <li>
          <strong>プライバシー重視</strong> — アクセス解析・広告・トラッキングは一切行いません。
        </li>
        <li>
          <strong>アクセシビリティ</strong> — デジタル庁デザインシステム（DADS）に準拠した設計です。
        </li>
      </ul>
    </section>

    <section class="mb-10">
      <h2 class="mb-4 font-bold section-heading text-default">ツール一覧</h2>
      <ul class="space-y-2">
        {
          tools.map((tool) => (
            <li>
              <a href={`/tools/${tool.slug}`} class="text-link link-text">
                {tool.name}
              </a>
              <span class="ml-2 caption text-muted">— {tool.description}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section>
      <h2 class="mb-3 font-bold section-heading text-default">技術スタック</h2>
      <ul class="space-y-1 text-body">
        <li><strong>フレームワーク:</strong> Astro 6 + React 19</li>
        <li><strong>スタイリング:</strong> Tailwind CSS v4</li>
        <li><strong>言語:</strong> TypeScript</li>
        <li><strong>ホスティング:</strong> Cloudflare Pages</li>
      </ul>
    </section>
  </main>
</BaseLayout>
