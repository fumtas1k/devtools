---
import ToolLayout from '@/layouts/ToolLayout.astro';
import ToolInfoSection from '@/components/ui/ToolInfoSection.astro';
import { MarkdownEditor as MarkdownEditorTool } from '@/components/tools/MarkdownEditor';
import { tools } from '@/data/tools';

const tool = tools.find((t) => t.slug === 'markdown-editor')!;
---

<ToolLayout tool={tool}>
  <MarkdownEditorTool client:load />

  <ToolInfoSection>
    <p class="tool-info-body">
      markdownをリアルタイムにHTMLプレビューします。左ペインに入力した内容が即座に右ペインへ反映されます。
      GFM（GitHub Flavored Markdown）に対応しており、<strong>表・取り消し線・コードブロック</strong
      >を記述できます。 生成されたHTMLをクリップボードにコピーしたり、markdown原文を<code
        class="rounded px-1 font-mono bg-subtle text-sm">.md</code
      >ファイルとしてダウンロードできます。
      すべての処理はブラウザ内で完結し、入力内容は外部に送信されません。
    </p>
    <h3 class="mb-2 mt-4 tool-info-heading">特長</h3>
    <ul class="list-inside list-disc space-y-1 tool-info-list">
      <li>GFM 対応 — 表・取り消し線・コードブロック・引用をそのままプレビュー</li>
      <li>リアルタイム反映 — 入力と同時にプレビューが更新される</li>
      <li>HTMLコピー — サニタイズ済みのHTMLをそのままクリップボードにコピー</li>
      <li>.mdダウンロード — 入力したmarkdown原文をファイル保存</li>
      <li>ブラウザ完結 — 入力データは外部に送信されない</li>
    </ul>
    <h3 class="mb-2 mt-4 tool-info-heading">ユースケース</h3>
    <ul class="list-inside list-disc space-y-1 tool-info-list">
      <li>README や仕様書のmarkdownをブラウザでプレビューしたい</li>
      <li>markdownから生成したHTMLをコピーしてCMSやメールに貼りたい</li>
      <li>GFM の表やコードブロックの書き方を素早く確認したい</li>
    </ul>
  </ToolInfoSection>
</ToolLayout>
