---
import ToolLayout from '@/layouts/ToolLayout.astro';
import ToolInfoSection from '@/components/ui/ToolInfoSection.astro';
import { ConfigConverterTool } from '@/components/tools/ConfigConverter';
import { tools } from '@/data/tools';

const tool = tools.find((t) => t.slug === 'config-converter')!;
---

<ToolLayout tool={tool}>
  <ConfigConverterTool client:load />

  <ToolInfoSection>
    <p class="tool-info-body">
      YAML・JSON・TOML・.env（dotenv）を相互変換します。すべての処理はブラウザ内で完結し、
      入力データが外部に送信されることはありません。本番の設定ファイルや Terraform
      変数を安心して貼り付けて使えます。
    </p>
    <h3 class="mb-2 mt-4 tool-info-heading">主な機能</h3>
    <ul class="list-inside list-disc space-y-1 tool-info-list">
      <li>YAML / JSON / TOML / .env の 4 形式を任意の組み合わせで相互変換</li>
      <li>同形式への変換は整形（フォーマット）として機能。YAML はコメントを保持</li>
      <li>JSON Schema を貼り付けて出力データを検証（draft-04 / draft-07 対応）</li>
      <li>.env 出力はフラットな KEY=VALUE のみ対応。ネストオブジェクトは変換不可</li>
    </ul>
    <h3 class="mb-2 mt-4 tool-info-heading">ユースケース</h3>
    <ul class="list-inside list-disc space-y-1 tool-info-list">
      <li>Docker Compose の環境変数を .env ファイルから YAML 設定に変換したい</li>
      <li>Terraform の tfvars を JSON 形式で確認したい</li>
      <li>YAML 設定ファイルを整形・コメント保持したまま再フォーマットしたい</li>
      <li>設定ファイルが JSON Schema に準拠しているか検証したい</li>
    </ul>
  </ToolInfoSection>
</ToolLayout>
